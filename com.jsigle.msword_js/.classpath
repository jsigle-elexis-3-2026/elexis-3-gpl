<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry exported="true" kind="lib" path="lib/"/>
	<classpathentry exported="true" kind="lib" path="rsc/"/>
	<classpathentry exported="true" kind="lib" path="lib/jacob.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/officebean.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jurt.jar" sourcepath="/libreOffice/incoming/libreoffice-ure-3.3.4.1/jurt"/>
	<classpathentry exported="true" kind="lib" path="lib/bootstrapconnector.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="lib" path="lib/java_uno_accessbridge.jar"/>
	<classpathentry kind="lib" path="lib/java_uno.jar"/>
	<classpathentry kind="lib" path="lib/juh.jar"/>
	<classpathentry kind="lib" path="lib/junit-3.8.1.jar"/>
	<classpathentry kind="lib" path="lib/jut.jar"/>
	<classpathentry kind="lib" path="lib/registry-3.1.3.jar"/>
	<classpathentry kind="lib" path="lib/ridl.jar"/>
	<classpathentry kind="lib" path="lib/sandbox.jar"/>
	<classpathentry kind="lib" path="lib/unoil.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
